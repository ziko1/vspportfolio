# Isolated local development only. The service binds to loopback by default.
PILOT_BIND=127.0.0.1:9180
# DATABASE_URL=postgres://pilot_readonly:<password>@127.0.0.1:5432/pilot
# Explicit host, user, password and database are required; percent-encode credentials.
# Plaintext is allowed only for literal loopback IPs (localhost becomes 127.0.0.1).
# Remote disposable databases require sslmode=verify-full, with sslrootcert if needed.
# DATABASE_URL=postgres://pilot_readonly:<password>@test-db.example/pilot?sslmode=verify-full
# PG* connection environment overrides and URL host/user/options overrides are rejected.
# Do not use production credentials, import customer data, or commit real secrets.

